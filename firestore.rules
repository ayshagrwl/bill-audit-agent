rules_version = '2';
// Cloud Firestore rules for BillAudit Pro.
// Paste into Firebase Console > Firestore Database > Rules, then Publish.
// Only the bill_audits collection is reachable; audits can be added and read, never deleted.
service cloud.firestore {
  match /databases/{database}/documents {
    match /bill_audits/{auditId} {
      allow read: if true;
      allow create, update: if request.resource.data.auditId == auditId
                            && request.resource.data.agent is string
                            && request.resource.data.rows is list
                            && request.resource.data.rows.size() <= 5000;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
